{
  "name": "efflife-desk",
  "version": "1.7.0",
  "private": true,
  "type": "module",
  "overrides": {
    "brace-expansion": "2.1.7",
    "source-map-js": "1.2.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "build:sidecar": "python ../../scripts/build_plan_helper_sidecar.py",
    "release:check": "python ../../scripts/check_release_config.py",
    "release:mobile-check": "python ../../scripts/check_mobile_release_config.py",
    "mobile:android:init": "tauri android init",
    "mobile:android:build": "tauri android build --config src-tauri/tauri.mobile.conf.json",
    "mobile:android:build:managed": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/build_android_managed.ps1",
    "mobile:ios:init": "tauri ios init",
    "mobile:ios:build": "tauri ios build --config src-tauri/tauri.mobile.conf.json",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.0",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-shell": "^2.3.6",
    "@types/file-saver": "^2.0.7",
    "chart.js": "^4.4.7",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-chartjs": "^5.3.2",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vue-tsc": "^2.2.0"
  }
}

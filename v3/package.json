{
  "name": "effilife",
  "version": "3.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3420",
    "build": "npm run check:version && node scripts/sync-frame.mjs --check && vue-tsc --noEmit && vite build",
    "sync:frame": "node scripts/sync-frame.mjs",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "check:version": "node scripts/version.mjs",
    "verify": "npm run test && npm run build && npm run test:browser",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/noto-sans-sc": "5.3.1",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@tauri-apps/plugin-fs": "2.7.1",
    "jszip": "3.10.2",
    "@lucide/vue": "1.72.0",
    "reka-ui": "2.11.0",
    "vue": "3.5.45",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "24.10.1",
    "@vitejs/plugin-vue": "6.0.10",
    "fake-indexeddb": "6.2.8",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  }
}
